# Local development defaults
# For Docker Compose, use the service hostnames instead of localhost:
# DATABASE_URL=postgres://redir:redir@db:5432/redir?sslmode=disable
# REDIS_ADDR=redis:6379
# STORAGE_SERVICE_ENDPOINT=http://minio:9000

PORT=5000
SERVER_ADDRESS=:5000
ENVIRONMENT=development

DATABASE_URL=postgres://redir:redir@localhost:5432/redir?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

CLIENT_DASHBOARD=http://localhost:3000
CLIENT_LOGIN_URL=http://localhost:3000/login

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=

STORAGE_SERVICE_ACCESS_KEY_ID=minioadmin
STORAGE_SERVICE_SECRET_ACCESS_KEY=minioadmin
STORAGE_SERVICE_ENDPOINT=http://localhost:9000
BUCKET_NAME=redir
BUCKET_ROOT=uploads
DOMAIN=http://localhost:5000
DATA_GET_PATH=/api/v1/assets


